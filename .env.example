# Copy to .env locally; never commit credentials. Studio loads .env.
APP_CONFIG_PATH=config/example.json
MASTRA_DATABASE_URL=file:.data/mastra.db
# Required only for live model calls in Studio, not npm run demo or npm test.
OPENAI_API_KEY=
# Judge model is independent of the agent model in business config.
EVAL_JUDGE_MODEL=openai/gpt-4.1-mini
# Native background scoring. Set false for manual-only operation; 0.1 samples 10%.
EVALS_ENABLED=true
EVALS_SAMPLE_RATE=0.1
# Used by read-only connection checks and the Telegram runner. Never paste real tokens in chat.
FIC_ACCESS_TOKEN=
TELEGRAM_BOT_TOKEN=

# Telegram uses fictional records by default; read-only uses the real catalogue without saves.
CONNECTOR_MODE=demo
# Optional: disable Mastra CLI anonymous usage telemetry.
MASTRA_TELEMETRY_DISABLED=1

# JEV identity resolution shared by Telegram and Studio.
# off: legacy; shadow: record judgments without applying them; on: authoritative matching.
TYPESAFE_API_KEY=
JEV_MODE=off
JEV_MODEL=jev-1.13.0
# Total call budget, including SDK retries.
JEV_TIMEOUT_MS=15000
JEV_MAX_RETRIES=1
